@model List<StayPilot.Application.DTOs.HeroDtos.ResultHeroSectionDto>

@{
    ViewData["Title"] = "Hero Sections";
}

@if (TempData["AdminSuccess"] is not null)
{
    <div class="admin-alert admin-alert-success">@TempData["AdminSuccess"]</div>
}

@if (TempData["AdminError"] is not null)
{
    <div class="admin-alert admin-alert-error">@TempData["AdminError"]</div>
}

<div class="admin-page-head">
    <div>
        <h2>Hero Section Management</h2>
        <p>Control the premium landing page hero content from the admin panel.</p>
    </div>

    <div class="admin-filter-actions">
        <a asp-area="Admin" asp-controller="HeroSections" asp-action="Create" class="active">
            Create New Hero
        </a>
    </div>
</div>

<div class="admin-hero-grid">
    @if (Model.Any())
    {
        foreach (var hero in Model)
        {
            <article class="admin-hero-card">
                <div class="admin-hero-preview" style="background-image: url('@hero.BackgroundImageUrl');">
                    <div>
                        <span>@hero.Subtitle</span>
                        <h3>@hero.Title</h3>
                        <p>@hero.Description</p>
                    </div>
                </div>

                <div class="admin-hero-body">
                    <div class="admin-hero-meta">
                        <span>Display Order: @hero.DisplayOrder</span>

                        @if (hero.IsActive)
                        {
                            <span class="admin-badge admin-badge-success">Active</span>
                        }
                        else
                        {
                            <span class="admin-badge admin-badge-muted">Passive</span>
                        }
                    </div>

                    <div class="admin-hero-actions">
                        <a asp-area="Admin"
                           asp-controller="HeroSections"
                           asp-action="Update"
                           asp-route-id="@hero.Id">
                            Edit
                        </a>

                        @if (hero.IsActive)
                        {
                            <form asp-area="Admin"
                                  asp-controller="HeroSections"
                                  asp-action="Deactivate"
                                  asp-route-id="@hero.Id"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="secondary">Deactivate</button>
                            </form>
                        }
                        else
                        {
                            <form asp-area="Admin"
                                  asp-controller="HeroSections"
                                  asp-action="Activate"
                                  asp-route-id="@hero.Id"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit">Activate</button>
                            </form>
                        }

                        <form asp-area="Admin"
                              asp-controller="HeroSections"
                              asp-action="Delete"
                              asp-route-id="@hero.Id"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to delete this hero section?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="danger">Delete</button>
                        </form>
                    </div>
                </div>
            </article>
        }
    }
    else
    {
        <div class="admin-empty-state">
            <h3>No hero sections found.</h3>
            <p>Create your first hero section to power the public landing page.</p>
            <a asp-area="Admin" asp-controller="HeroSections" asp-action="Create">Create Hero Section</a>
        </div>
    }
</div>