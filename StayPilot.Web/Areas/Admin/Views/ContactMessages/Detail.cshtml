@model StayPilot.Application.DTOs.ContactDtos.ResultContactMessageDto
@using StayPilot.Domain.Enums

@{
    ViewData["Title"] = "Message Detail";
}

@if (TempData["AdminSuccess"] is not null)
{
    <div class="admin-alert admin-alert-success">@TempData["AdminSuccess"]</div>
}

@if (TempData["AdminError"] is not null)
{
    <div class="admin-alert admin-alert-error">@TempData["AdminError"]</div>
}

<div class="admin-page-head">
    <div>
        <h2>@Model.Subject</h2>
        <p>Message received from @Model.FullName.</p>
    </div>

    <div class="admin-filter-actions">
        <a asp-area="Admin" asp-controller="ContactMessages" asp-action="Index">
            Back to Messages
        </a>
    </div>
</div>

<section class="admin-message-detail-grid">
    <article class="admin-panel admin-message-card">
        <div class="admin-panel-header">
            <div>
                <h2>Message Content</h2>
                <p>Full contact message details.</p>
            </div>

            @if (Model.Status == ContactMessageStatus.Unread)
            {
                <span class="admin-badge admin-badge-warning">Unread</span>
            }
            else if (Model.Status == ContactMessageStatus.Archived)
            {
                <span class="admin-badge admin-badge-muted">Archived</span>
            }
            else
            {
                <span class="admin-badge admin-badge-success">Read</span>
            }
        </div>

        <div class="admin-message-body">
            <p>@Model.Message</p>
        </div>
    </article>

    <aside class="admin-panel admin-message-meta">
        <div class="admin-panel-header">
            <div>
                <h2>Sender Info</h2>
                <p>Contact identity and workflow actions.</p>
            </div>
        </div>

        <div class="admin-meta-list">
            <div>
                <span>Full Name</span>
                <strong>@Model.FullName</strong>
            </div>

            <div>
                <span>Email</span>
                <strong>@Model.Email</strong>
            </div>

            <div>
                <span>Phone</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</strong>
            </div>

            <div>
                <span>Received</span>
                <strong>@Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</strong>
            </div>
        </div>

        <div class="admin-detail-actions">
            @if (Model.Status != ContactMessageStatus.Read)
            {
                <form asp-area="Admin"
                      asp-controller="ContactMessages"
                      asp-action="MarkAsRead"
                      asp-route-id="@Model.Id"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit">Mark as Read</button>
                </form>
            }

            @if (Model.Status != ContactMessageStatus.Archived)
            {
                <form asp-area="Admin"
                      asp-controller="ContactMessages"
                      asp-action="Archive"
                      asp-route-id="@Model.Id"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="secondary">Archive</button>
                </form>
            }

            <form asp-area="Admin"
                  asp-controller="ContactMessages"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post"
                  onsubmit="return confirm('Are you sure you want to delete this message?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="danger">Delete Message</button>
            </form>
        </div>
    </aside>
</section>