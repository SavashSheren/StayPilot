@model StayPilot.Application.DTOs.AiDtos.ResultAiConversationLogDto

@{
    ViewData["Title"] = "AI Conversation Detail";
}

@if (TempData["AdminError"] is not null)
{
    <div class="admin-alert admin-alert-error">@TempData["AdminError"]</div>
}

<div class="admin-page-head">
    <div>
        <h2>AI Conversation Detail</h2>
        <p>Inspect the selected AI travel assistant interaction.</p>
    </div>

    <div class="admin-filter-actions">
        <a asp-area="Admin" asp-controller="AiConversationLogs" asp-action="Index">
            Back to AI Conversations
        </a>
    </div>
</div>

<section class="admin-ai-detail-grid">
    <main class="admin-panel">
        <div class="admin-panel-header">
            <div>
                <h2>User Question</h2>
                <p>Original question submitted to the AI assistant.</p>
            </div>

            @if (Model.IsSuccessful)
            {
                <span class="admin-badge admin-badge-success">Success</span>
            }
            else
            {
                <span class="admin-badge admin-badge-warning">Failed</span>
            }
        </div>

        <div class="admin-ai-message-block question">
            <pre>@Model.UserQuestion</pre>
        </div>

        <div class="admin-panel-header">
            <div>
                <h2>AI Answer</h2>
                <p>Response generated by the configured AI provider.</p>
            </div>
        </div>

        <div class="admin-ai-message-block answer">
            <pre>@Model.AiAnswer</pre>
        </div>
    </main>

    <aside class="admin-panel">
        <div class="admin-panel-header">
            <div>
                <h2>Conversation Metadata</h2>
                <p>Provider and usage information.</p>
            </div>
        </div>

        <div class="admin-meta-list">
            <div>
                <span>Model Name</span>
                <strong>@Model.ModelName</strong>
            </div>

            <div>
                <span>Token Usage</span>
                <strong>@Model.TokenUsage</strong>
            </div>

            <div>
                <span>Created Date</span>
                <strong>@Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</strong>
            </div>

            <div>
                <span>Error Message</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.ErrorMessage) ? "No error" : Model.ErrorMessage)</strong>
            </div>
        </div>

        <div class="admin-detail-actions">
            <form asp-area="Admin"
                  asp-controller="AiConversationLogs"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post"
                  onsubmit="return confirm('Are you sure you want to delete this AI conversation log?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="danger">Delete Conversation Log</button>
            </form>
        </div>
    </aside>
</section>