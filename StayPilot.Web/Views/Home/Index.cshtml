@{
    var weather = ViewBag.Weather as StayPilot.Application.DTOs.WeatherDtos.ResultWeatherDto;
    var currency = ViewBag.Currency as StayPilot.Application.DTOs.CurrencyDtos.ResultCurrencyRateDto;
}

<section class="sp-section intelligence-section">
    <div class="sp-container">
        <div class="sp-section-head">
            <div>
                <div class="sp-section-kicker">Travel Intelligence</div>
                <h2 class="sp-section-title">Know before you book</h2>
            </div>

            <p class="sp-section-desc">
                StayPilot combines destination weather and currency intelligence to help travelers make better booking decisions.
            </p>
        </div>

        <div class="intelligence-grid">
            <article class="intelligence-card weather-card">
                <div class="intelligence-icon">☀</div>

                <div>
                    <span>Current Weather</span>
                    <h3>@(weather?.CityName ?? "Istanbul")</h3>
                    <strong>@(weather?.Temperature ?? 0)°C</strong>
                    <p>
                        @(weather?.Condition ?? "Unavailable") ·
                        Humidity @(weather?.Humidity ?? 0)% ·
                        Wind @(weather?.WindSpeed ?? 0) km/h
                    </p>
                </div>
            </article>

            <article class="intelligence-card currency-card">
                <div class="intelligence-icon">₺</div>

                <div>
                    <span>Currency Rate</span>
                    <h3>@(currency?.BaseCurrency ?? "USD") → @(currency?.TargetCurrency ?? "TRY")</h3>
                    <strong>@(currency?.Rate ?? 0)</strong>
                    <p>
                        Last updated:
                        @((currency?.UpdatedDate ?? DateTime.UtcNow).ToLocalTime().ToString("dd MMM yyyy HH:mm"))
                    </p>
                </div>
            </article>
        </div>
    </div>
</section>