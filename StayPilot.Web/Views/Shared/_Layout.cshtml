<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - StayPilot</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/staypilot.css" asp-append-version="true" />
</head>
<body>
    <header class="sp-header">
        <div class="sp-container sp-nav">
            <a class="sp-brand" asp-controller="Home" asp-action="Index">
                <span class="sp-brand-icon">S</span>
                <span>StayPilot</span>
            </a>

            <nav class="sp-menu">
                <a href="#destinations">Destinations</a>
                <a href="#ai">AI Assistant</a>
                <a href="#insights">Insights</a>
                <a href="#contact">Contact</a>
            </nav>

            <a class="sp-nav-btn" href="#search">Start Planning</a>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="sp-footer">
        <div class="sp-container sp-footer-inner">
            <div>
                <h3>StayPilot</h3>
                <p>AI powered hotel discovery and travel intelligence platform.</p>
            </div>

            <div class="sp-footer-links">
                <a href="#destinations">Destinations</a>
                <a href="#ai">AI Assistant</a>
                <a href="#insights">Travel Insights</a>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>